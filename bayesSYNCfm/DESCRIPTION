Package: bayesSYNCfm
Type: Package
Title: Group-Informed BAYESian Model For High-dimensional Functional Factor Analysis Of Shared Latent dYNamiCs
Version: 0.1.0
Authors@R: c(
    person("Salima", "Jaoua",
            email = "jaoua@ifi.uzh.ch",
            role = "aut"),
    person("Daniel", "Temko",
